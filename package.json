{
  "name": "adventureforge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "AI-authored, deterministic text RPG engine for a unified open-world adventure runtime.",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "af-replay": "./bin/replay.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format:check": "prettier --check src bin scripts agents tests blind-tester ui",
    "format": "prettier --write src bin scripts agents tests blind-tester ui",
    "lint": "eslint src bin scripts agents tests blind-tester ui",
    "test": "vitest run --reporter=dot",
    "test:fast": "vitest run --reporter=dot --project standard",
    "test:exhaustive": "vitest run --reporter=dot --project exhaustive-rpg --project variant-liveness-proof --project ending-render-proof --project metamorphic-observation",
    "test:coverage": "vitest run --project standard --coverage --reporter=dot --testTimeout=300000",
    "test:ending-render-proof": "vitest run --project ending-render-proof --reporter=dot",
    "test:durations": "tsx scripts/measure-test-durations.ts",
    "test:census": "tsx scripts/test-duration-census.ts",
    "verify:integrity": "tsx scripts/verify-integrity.ts",
    "verify:bug-traces": "tsx scripts/verify-bug-traces.ts",
    "verify:opening-density": "tsx scripts/verify-opening-density.ts",
    "audit:ending-render-proof": "tsx scripts/run-with-soft-budget.ts --label ending-render-proof --seconds 420 --history ai-runs/performance-budget-history.json -- npm run test:ending-render-proof",
    "audit:standard-coverage": "tsx scripts/run-with-soft-budget.ts --label standard-suite --seconds 4200 --history ai-runs/performance-budget-history.json -- npm run test:coverage",
    "audit:non-player": "npm run verify:bug-traces && npm run verify:opening-density && npm run audit:ending-render-proof && npm run audit:standard-coverage",
    "health": "npm run verify:integrity && npm run verify:bug-traces && npm run verify:opening-density && npm run typecheck && npm run lint && npm run format:check && npm run ui:typecheck && npm run validate && npm test",
    "health:fast": "npm run verify:integrity && npm run verify:bug-traces && npm run verify:opening-density && npm run typecheck && npm run lint && npm run format:check && npm run ui:typecheck && npm run validate && npm run test:fast",
    "test:watch": "vitest",
    "replay": "tsx bin/replay.ts",
    "validate": "tsx bin/validate.ts",
    "play": "tsx bin/rpg_play.ts",
    "overworld": "tsx bin/overworld_play.ts",
    "author": "tsx bin/author.ts",
    "inspect": "tsx bin/inspect.ts",
    "assess": "tsx bin/assess.ts",
    "corpus:seal": "npx tsx bin/seal-corpus.ts",
    "crawl": "tsx bin/crawl.ts",
    "crawl:smoke": "tsx bin/crawl.ts --smoke",
    "crawl:deep": "tsx bin/crawl.ts --deep",
    "blind": "node blind-tester/blind-launch.mjs",
    "blind:smoke": "node blind-tester/smoke.mjs",
    "blind:feedback": "tsx scripts/update-blind-feedback-ledger.ts",
    "blind:telemetry": "node blind-tester/telemetry.mjs summary",
    "qa:bucket": "tsx bin/qa.ts",
    "qa:triage": "tsx bin/triage.ts",
    "qa:publish": "tsx scripts/publish-playtest-sessions.ts",
    "playtest:loop": "bash playtest-loop.sh",
    "playtest:ingest": "tsx bin/ingest-playtest-session.ts",
    "playtest:grok-wave": "tsx bin/playtest-grok-wave.ts",
    "playtest:record": "tsx bin/record-playtest-session.ts",
    "submit": "tsx bin/submit.ts",
    "work": "tsx bin/work.ts",
    "intake:sync": "tsx scripts/sync-intake-github.ts",
    "intake:sync:linear": "tsx scripts/sync-intake-linear.ts",
    "fleet": "node blind-tester/fleet.mjs",
    "fleet:mock": "node blind-tester/fleet.mjs --mock",
    "starting-slice:pilot": "tsx bin/check-starting-slice-pilot.ts",
    "starting-slice:certify": "tsx bin/certify-starting-slice.ts",
    "feedback:compile": "tsx bin/feedback.ts",
    "feedback:status": "tsx bin/feedback.ts --status",
    "feedback:rebootstrap": "tsx bin/feedback.ts --rebootstrap",
    "spectate": "tsx bin/spectate.ts",
    "ui:dev": "npm --prefix ui run dev",
    "ui:build": "npm --prefix ui run build",
    "mcp": "tsx src/mcp/server.ts",
    "ai:loop": "tsx src/ai-loop.ts",
    "loop:rotate-state": "tsx scripts/rotate-loop-state.ts",
    "loop:verify-playtest": "tsx scripts/verify-cycle-playtest.ts",
    "loop:seal-feedback": "tsx scripts/seal-feedback-acceptance.ts",
    "loop:bar": "tsx scripts/cycle-bar.ts",
    "loop:failures": "tsx scripts/loop-failure-ledger.ts",
    "loop:status": "bash scripts/loop-status.sh",
    "loop:stop": "bash scripts/loop-stop.sh",
    "ui:typecheck": "tsc -p ui/tsconfig.json --noEmit && tsc -p ui/tsconfig.tests.json --noEmit",
    "doctor": "tsx bin/doctor.ts",
    "ship": "tsx scripts/ship.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "yaml": "^2.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^3.22.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^4.1.7"
  }
}
