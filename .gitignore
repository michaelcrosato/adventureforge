node_modules/
dist/
ui/dist/
*.log
ui/.vite-dev*.log
.DS_Store
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Ad-hoc recorded playthroughs (curated bug artifacts live in traces/bugs/)
/traces/*.json

# Autonomous AFK loop scratch evidence
ai-runs/
.tmp/
saves/*.json
coverage/
# Rotated tail of the AFK loop log (git history preserves old AI_LOOP_STATE.md versions)
AI_LOOP_STATE_ARCHIVE.md

# Repo-local Codex config is tracked; runtime state/auth/session data is not.
.codex/*
!.codex/config.toml

# Local maintenance/runtime state
.agent-cleaner/
*.tsbuildinfo

# Local interactive-agent/browser scratch (never durable test evidence)
/.playwright-mcp/

# Blind-tester run outputs (regenerable; not source)
blind-tester/reports/*
!blind-tester/reports/.gitkeep


# Secrets — never commit. This is a public repo and the engine needs no API keys;
# any local credentials stay in an ignored env file.
.env
.env.*
*.pem
*.key
*.p12
secrets.json
**/credentials.json

# Playtest session corpus: written by the QA loop, published to its own branch by
# `npm run qa:publish` rather than committed here. A mass-parallel cohort writes
# hundreds of session directories, and a dev loop whose worktree is never clean
# cannot take a provisional commit.
ai-runs/playtest/

# Lane worktrees (docs/parallel_lanes.md): linked checkouts live under here; an
# unignored worktree directory would show as untracked noise in every status.
.claude/worktrees/
